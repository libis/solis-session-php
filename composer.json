{
    "name": "solis/session-php",
    "description": "PHP client for solis-identity: validates the shared solis_session RS256 JWT (JWKS) and maps claims to roles. The PHP counterpart of the Ruby solis-session middleware.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Solis\\Session\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Solis\\Session\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
